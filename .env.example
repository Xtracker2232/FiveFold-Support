# Copy this file to .env and fill in the values.
# (Right click > Copy ID in Discord, with Developer Mode enabled)

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Welcome
WELCOME_CHANNEL_ID=
AUTOROLE_ID=

# Moderation
MOD_LOG_CHANNEL_ID=
STAFF_ROLE_ID=

# Tickets
TICKET_CATEGORY_ID=

# Community
ANNOUNCE_CHANNEL_ID=
SUGGESTION_CHANNEL_ID=

# Web panel (on Railway, PORT is set automatically: don't add PANEL_HOST/PANEL_PORT)
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
PANEL_PASSWORD=change-me-to-something-long

# Optional: folder for saved data (warnings). On Railway, mount a Volume and set DATA_DIR=/data
DATA_DIR=
